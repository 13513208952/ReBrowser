.idea/
local.properties
**/build/
# Reproducible source-only release tooling, not Gradle output.
!tools/build/
tools/build/*
!tools/build/*.py
!tools/build/*.md
!tools/build/*.gradle
!tools/build/requirements.txt
*.iml
.cxx/
.externalNativeBuild/

# Administrator secrets and local diagnostics
*.pem
*.reoutlook-admin
*.db
*.sqlite
*.sqlite3
*.log
__pycache__/
*.py[cod]

# Local package outputs, signing material and heap/recording diagnostics
*.apk
*.aab
*.apks
*.idsig
*.jks
*.keystore
*.hprof
*.heapdump
*.jfr
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
.DS_Store
