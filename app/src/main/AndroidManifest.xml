<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only the system installer may complete a user-selected renamed APK installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReOutlook"
        android:usesCleartextTraffic="false">

        <provider
            android:name=".MaintenanceProvider"
            android:authorities="io.github.reoutlook.maintenance"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />

        <provider
            android:name=".ReBrowserAdminProvider"
            android:authorities="io.github.reoutlook.rebrowser.admin"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".MaintenanceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ArchiveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReBrowserAdminActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReBrowserSettingsActivity"
            android:exported="false"
            android:label="@string/rebrowser_settings_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReBrowserSitePermissionsActivity"
            android:exported="false"
            android:label="@string/rebrowser_permissions_name"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReBrowserActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="@string/rebrowser_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReBrowserLauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_rebrowser_launcher"
            android:label="@string/rebrowser_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="io.github.reoutlook.rebrowser.launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReBrowserLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:icon="@drawable/ic_rebrowser_launcher"
            android:label="@string/rebrowser_name"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ReBrowserApkProvider"
            android:authorities="io.github.reoutlook.apk-handoff"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".ReBrowserRenamedApkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_rebrowser_launcher"
            android:label="@string/rebrowser_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <!-- API 31+ has a real suffix matcher; older systems use bounded simple-glob alternatives. -->
                <data android:pathSuffix=".1" tools:targetApi="s" />
                <data android:pathPattern=".*\\.1" />
                <data android:pathPattern=".*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.1" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".1" tools:targetApi="s" />
                <data android:pathPattern=".*\\.1" />
                <data android:pathPattern=".*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.1" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.1" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Only this alias is toggled; MainActivity remains available for in-app routing. -->
        <activity-alias
            android:name=".ReOutlookLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
