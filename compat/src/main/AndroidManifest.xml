<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ReBrowserApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_rebrowser_launcher"
        android:label="ReBrowser GeckoView"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReOutlook"
        android:usesCleartextTraffic="false">

        <service
            android:name=".ReBrowserMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
        <receiver
            android:name=".ReBrowserMusicControlReceiver"
            android:exported="false" />
        <activity
            android:name=".ReBrowserMusicActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize"
            android:exported="false"
            android:icon="@drawable/ic_rbmusic_launcher"
            android:label="音乐"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.rebrowser.compat.music"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".ReBrowserMusicLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_rbmusic_launcher"
            android:label="音乐"
            android:targetActivity=".ReBrowserMusicActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.example.piliplus.MainActivity" />
        <activity-alias
            android:name=".ReVideoLauncher"
            android:exported="true"
            android:icon="@mipmap/revideo_ic_launcher"
            android:label="ReVideo"
            android:targetActivity="com.example.piliplus.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ReBrowserSubapplicationSettingsActivity"
            android:exported="false"
            android:label="应用设置"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ArchiveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/reoutlook_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".ReOutlookLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/reoutlook_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ReBrowserSettingsActivity"
            android:exported="false"
            android:label="@string/rebrowser_settings_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReBrowserSitePermissionsActivity"
            android:exported="false"
            android:label="@string/rebrowser_permissions_name"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReBrowserActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="@string/rebrowser_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReBrowserLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_rebrowser_launcher"
            android:label="@string/rebrowser_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="io.github.rebrowser.compat.launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ReBrowserLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:icon="@drawable/ic_rebrowser_launcher"
            android:label="@string/rebrowser_name"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
