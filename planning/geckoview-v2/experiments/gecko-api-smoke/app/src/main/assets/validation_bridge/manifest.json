{
  "manifest_version": 2,
  "name": "Fixed local synthetic validation connector",
  "version": "1.1",
  "browser_specific_settings": {"gecko": {"id": "validation@rebrowser.invalid"}},
  "background": {"scripts": ["background.js"]},
  "permissions": ["nativeMessaging", "geckoViewAddons", "nativeMessagingFromContent", "scripting", "http://127.0.0.1/*"],
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]
}
