      "requirements": [
        "R09"
      ]
    },
    {
      "id": "D06",
      "state": "confirmed",
      "decision": "根跨所有最高管理员名单；普通最高管理员名单彼此/与根专有名单隔离",
      "requirements": [
        "R15",
        "R16"
      ]
    },
    {
      "id": "D07",
      "state": "confirmed",
      "decision": "有线/无线ADB、应用内/跨应用/动态介入统一授权",
      "requirements": [
        "R18",
        "R19"
      ]
    },
    {
      "id": "D08",
      "state": "confirmed",
      "decision": "高等级充分时必须获得对应能力；管理权限同步扩张",
      "requirements": [
        "R12",
        "R13"
      ]
    },
    {
      "id": "D09",
      "state": "confirmed",
      "decision": "离线邮件高压缩；子应用存储以量级估算优先",
      "requirements": [
        "R21",
        "R22"
      ]
    },
    {
      "id": "D10",
      "state": "confirmed",
      "decision": "混合规划/原话独立留存/持续审查",
      "requirements": [
        "R26",
        "R27"
      ]
    },
    {
      "id": "D11",
      "state": "confirmed",
      "decision": "允许选择性加密/混淆，但性能敏感；依赖节制并R8裁剪",
      "requirements": [
        "R28",
        "R29",
        "R30"
      ]
    },
    {
      "id": "D12",
      "state": "verified-upstream",
      "decision": "2026-10-17 latest stable: org.mozilla.geckoview:geckoview:158.0.20261007201254",
      "requirements": [
        "R02"
      ]
    },
    {
      "id": "D13",
      "state": "design-proposal",
      "decision": "领域动作注册表为UI及全部调试入口的共同执行边界；传输不得直接调用存储/内核",
      "requirements": [
        "R10",
        "R18",
        "R19"
      ]
    },
    {
      "id": "D14",
      "state": "design-proposal",
      "decision": "机主授权提升/激活有效等级，避免等级足够后又被隐藏规则否决",
      "requirements": [
        "R11",
        "R12"
      ]
    },
    {
      "id": "D15",
      "state": "design-proposal",
      "decision": "新密钥按APK签名/管理员身份/设备安装/插件委托/数据加密分域",
      "requirements": [
        "R07",
        "R09",
        "R17",
        "R20",
        "R28"
      ]
    },
    {
      "id": "D16",
      "state": "design-proposal",
      "decision": "先比较平台Deflate/GZIP与可选Zstd等高压缩候选，不先引入压缩库",
      "requirements": [
        "R21",
        "R29"
      ]
    },
    {
      "id": "D17",
      "state": "confirmed",
      "decision": "有效管理等级≥对应能力需求等级即可控制；同级允许。",
      "requirements": [
        "R12"
      ],
      "ownerSources": [
        "O13"
      ]
    },
    {
      "id": "D18",
      "state": "confirmed",
      "decision": "白名单隔离保护设备隐私及枚举/管理/借用权限；公钥作为策略匹配标识，不与具体设备资料混为一谈。",
      "requirements": [
        "R15",
        "R17"
      ],
      "ownerSources": [
        "O13"
      ]
    },
    {
      "id": "D19",
      "state": "confirmed",
      "decision": "持钥证明可跨辅助程序使用；私钥可复制是已接受的凭据模型，不额外限定调用者软件来源。",
      "requirements": [
        "R20",
        "R35"
      ],
      "ownerSources": [
        "O14"
      ]
    },
    {
      "id": "D20",
      "state": "confirmed",
      "decision": "高级管理员仅预编译准入；新增高级必须更新包，不能动态增加。",
      "requirements": [
        "R31"
      ],
      "ownerSources": [
        "O14"
      ]
    },
    {
      "id": "D21",
      "state": "confirmed",
      "decision": "严格更高级可禁用更低；根不可禁用且高于所有最高管理员。",
      "requirements": [
        "R13",
        "R32"
      ],
      "ownerSources": [
        "O14"
      ]
    },
    {
      "id": "D22",
      "state": "refined-by-O16",
      "decision": "同新包更新根身份变化时不继承旧数据；先机主许可，保留正确包抢救路径，继续时三确认后销毁仅本应用私有数据。",
      "requirements": [
        "R33",
        "R34"
      ],
      "ownerSources": [
        "O14"
      ],
      "refinement": "首次许可不是立即解锁；精确四步、两次验证、最后正常来源及销毁后解锁由D23-D25明确。"
    },
    {
      "id": "D23",
      "state": "confirmed",
      "decision": "B已确认：1次信任点击＋3次连续强行确认；后两次各自系统机主验证，无锁例外。",
      "requirements": [
        "R34",
        "R37"
      ],
      "ownerSources": [
        "O16"
      ]
    },
    {
      "id": "D24",
      "state": "confirmed",
      "decision": "身份源为APK签名＋根公钥组合，保存最后正常源穿越异常中间包；不得用last-installed覆盖。",
      "requirements": [
        "R33",
        "R36"
      ],
      "ownerSources": [
        "O16"
      ]
    },
    {
      "id": "D25",
      "state": "confirmed",
      "decision": "第三次强行确认有效后才销毁旧私有数据，销毁成功后才解锁；之前正确包救援仍成立。",
      "requirements": [
        "R34",
        "R38"
      ],
      "ownerSources": [
        "O16"
      ]
    },
    {
      "id": "D26",
      "state": "confirmed",
      "decision": "按助手节奏继续，不着急；绝大多数剩余工程问题由助手研究/论证/决定，不反复询问机主。",
      "requirements": [
        "R26"
      ],
      "ownerSources": [
        "O18"
      ]
    },
    {
      "id": "D27",
      "state": "confirmed",
      "decision": "继续独立推进；不专门主动汇报，机主需要进度时自行询问。真正材料/不可逆授权边界不因此取消。",
      "requirements": [
        "R26"
      ],
      "ownerSources": [
        "O21"
      ]
    }
