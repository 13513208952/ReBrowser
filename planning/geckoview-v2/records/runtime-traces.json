{
  "schema": 1,
  "revision": "R7",
  "modelOnly": true,
  "runtimeTested": false,
  "modelScope": "actual-dispatch admission/known-owner settlement/publication/quiescence only; no Android scheduling, no SDK/remote-effect guarantee; one generation integer stands for revoked target binding; publication flag refers current business observer, not all permitted internal aggregate caches",
  "cases": [
    {
      "id": "RT01",
      "scenario": "客户端超时不能释放真实读取槽",
      "events": [
        {
          "op": "submit",
          "task": "a",
          "action": "storage.query",
          "owner": "helper"
        },
        {
          "op": "ui_timeout",
          "task": "a"
        },
        {
          "op": "submit",
          "task": "b",
          "action": "storage.query"
        }
      ],
      "expectedResults": [
        "DISPATCHED",
        "ACTUAL_LANE_BUSY"
      ],
      "expectedTasks": {
        "a": {
          "running": true,
          "client": "DEADLINE_EXCEEDED",
          "published": false
        }
      },
      "state": "symbolic-design-example-not-Gecko-test"
    },
    {
      "id": "RT02",
      "scenario": "副作用超时不换路重发next",
